# Required
ANTHROPIC_API_KEY=

# Optional: override the models codepilot routes to.
# Some are served under a bare alias, others only under a dated id.
# CODEPILOT_STRONG_MODEL=claude-opus-5
# CODEPILOT_FAST_MODEL=claude-haiku-4-5-20251001

# ---------------------------------------------------------------------------
# Hosted mode only (`codepilot serve`). Ignored by the CLI.
# The full guide, and why each of these has no safe default, is in DEPLOYING.md.
# ---------------------------------------------------------------------------
# Required. At least 16 characters; the server refuses to start without it.
#   openssl rand -hex 24
# CODEPILOT_SERVER_TOKEN=

# Required. The directory of repositories this server may work on. A repository
# name in a request is resolved inside it and rejected if it escapes.
# CODEPILOT_WORKSPACE_ROOT=/srv/repos

# `docker` (default) or `local`. `local` runs model-chosen commands as the
# server process and additionally requires CODEPILOT_ALLOW_HOST_EXECUTION=1.
# CODEPILOT_SANDBOX=docker
# CODEPILOT_SANDBOX_IMAGE=codepilot-sandbox:latest
# CODEPILOT_ALLOW_HOST_EXECUTION=0

# Off by default: callers send their own key in X-Anthropic-Key, so the
# operator neither pays for nor holds anyone else's credentials.
# CODEPILOT_ALLOW_SERVER_KEY=0

# Ceilings per run. A request cannot raise its own.
# CODEPILOT_MAX_USD=1.00
# CODEPILOT_MAX_TURNS=40

# Extra executables beyond the read-only defaults, e.g. "ruff mypy npm".
# CODEPILOT_EXTRA_ALLOWED=
