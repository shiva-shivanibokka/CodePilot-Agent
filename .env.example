# ── Required ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Optional: GitHub integration (Issue mode) ────────────────────────────────
GITHUB_TOKEN=ghp_your-token-here

# ── Optional: Redis for session persistence ──────────────────────────────────
# If not set, sessions are stored in memory (lost on restart)
REDIS_URL=redis://localhost:6379

# ── Optional: Sandbox mode override ──────────────────────────────────────────
# "subprocess" (default, no Docker required) | "docker" | "e2b"
SANDBOX_TYPE=subprocess
